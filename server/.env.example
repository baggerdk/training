# Copy to server/.env (never commit it). Generate secrets with e.g.:  openssl rand -base64 48
# The three database passwords are used only when the volume is created the first time.

POSTGRES_PASSWORD=
OWNER_PASSWORD=
APP_PASSWORD=

# At least 32 characters
JWT_SECRET=

# Origins allowed to call the API: the Android app (Capacitor) and, during the transition, the old PWA
CORS_ORIGINS=https://localhost,https://baggerdk.github.io

# Invite links: <INVITE_BASE_URL><token>. Locally e.g. http://localhost:3000/invite/
INVITE_BASE_URL=https://api.<domæne>/invite/

# Cloudflare Tunnel token (Cloudflare phase)
TUNNEL_TOKEN=
